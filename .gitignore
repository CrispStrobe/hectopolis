# Build output lives on /mnt/storage (symlink) — never commit
build
build/
/build
**/build/
.dart_tool/
.packages
.pub-cache/
.pub/
pubspec_overrides.yaml
*.iml
.idea/
.vscode/
.DS_Store
*.log
# Flutter platform generated
**/ios/Flutter/.last_build_id
**/ios/Pods/
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/*.keystore
**/*.jks
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/
# Generated l10n
app/lib/l10n/generated/
# Rendered documentation site (tools/build_docs_site.dart); CI builds it
docs/_site/
# Raw datasets never enter the repo
/data/raw/
__pycache__/
*.pyc

# Local handover notes, not part of the project
HANDOVER.md
